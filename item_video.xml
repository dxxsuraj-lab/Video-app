<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="6dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#202630">
    <ImageView android:id="@+id/thumb" android:layout_width="match_parent"
        android:layout_height="120dp" android:scaleType="centerCrop"
        android:contentDescription="Video thumbnail" />
    <TextView android:id="@+id/videoName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFF"
        android:textSize="14sp" android:maxLines="2" android:ellipsize="end"
        android:paddingTop="6dp"/>
    <TextView android:id="@+id/videoInfo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#C0C7D1"
        android:textSize="12sp" android:paddingTop="2dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/fav" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="♥"/>
        <Button android:id="@+id/more" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="⋮"/>
    </LinearLayout>
</LinearLayout>
